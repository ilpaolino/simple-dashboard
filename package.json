{
  "name": "dev.dadda.simpledashboard",
  "version": "0.14.0",
  "description": "Simple Dashboard — Homey Flow notifications with actions on Wall Displays",
  "main": "app.js",
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit && tsc -p frontend --noEmit",
    "test": "node --import tsx --test --test-force-exit test/**/*.test.ts",
    "assets": "node scripts/generate-assets.mjs",
    "lint": "npm run typecheck",
    "measure:frontend": "node scripts/measure-frontend.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "homey",
    "welcome-wall",
    "http-server",
    "wall-display",
    "dashboard"
  ],
  "author": "ilpaolino",
  "license": "ISC",
  "dependencies": {
    "homey-api": "^3.16.1",
    "source-map-support": "^0.5.21",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tsconfig/node12": "^12.1.4",
    "@types/homey": "npm:homey-apps-sdk-v3-types",
    "@types/node": "^22.13.10",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

{
  "id": "dev.dadda.simpledashboard",
  "version": "0.9.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Simple Dashboard",
    "it": "Simple Dashboard"
  },
  "description": {
    "en": "Vanilla widget dashboard for Homey Pro wall displays with WebSocket realtime for lights, covers, and live configuration.",
    "it": "Dashboard a widget vanilla per wall display Homey Pro con sync realtime WebSocket per luci, tapparelle e configurazione."
  },
  "category": ["tools"],
  "tags": {
    "en": ["http", "websocket", "dashboard", "wall display", "widgets", "light", "cover", "realtime", "diagnostics"],
    "it": ["http", "websocket", "dashboard", "wall display", "widget", "luce", "tapparella", "realtime", "diagnostica"]
  },
  "permissions": ["homey:manager:api"],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "ilpaolino"
  },
  "brandColor": "#1F4B5C",
  "api": {
    "listDisplays": {
      "method": "GET",
      "path": "/displays"
    },
    "getDashboard": {
      "method": "GET",
      "path": "/displays/:displayId/dashboard"
    },
    "saveDashboard": {
      "method": "PUT",
      "path": "/displays/:displayId/dashboard"
    }
  }
}

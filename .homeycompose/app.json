{
  "id": "dev.dadda.simpledashboard",
  "version": "0.15.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Simple Dashboard",
    "it": "Simple Dashboard"
  },
  "description": {
    "en": "Vanilla widget dashboard for Homey Pro wall displays with interactive controls, Notification Center, optional camera media, auto-close, and Homey Flow notification actions.",
    "it": "Dashboard a widget vanilla per wall display Homey Pro con controlli interattivi, Notification Center, media camera opzionale, chiusura automatica e azioni Flow native per le notifiche."
  },
  "category": ["tools"],
  "tags": {
    "en": ["http", "websocket", "dashboard", "wall display", "widgets", "light", "cover", "notifications", "flow", "realtime", "diagnostics"],
    "it": ["http", "websocket", "dashboard", "wall display", "widget", "luce", "tapparella", "notifiche", "flow", "realtime", "diagnostica"]
  },
  "permissions": ["homey:manager:api"],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "ilpaolino"
  },
  "brandColor": "#1F4B5C",
  "api": {
    "listDisplays": {
      "method": "GET",
      "path": "/displays"
    },
    "getDashboard": {
      "method": "GET",
      "path": "/displays/:displayId/dashboard"
    },
    "saveDashboard": {
      "method": "PUT",
      "path": "/displays/:displayId/dashboard"
    },
    "listNotifications": {
      "method": "GET",
      "path": "/notifications"
    },
    "publishNotification": {
      "method": "POST",
      "path": "/notifications"
    },
    "updateNotification": {
      "method": "PUT",
      "path": "/notifications"
    },
    "removeNotification": {
      "method": "DELETE",
      "path": "/notifications/:notificationId"
    }
  }
}

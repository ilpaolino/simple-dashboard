{
  "id": "dev.dadda.simpledashboard",
  "version": "0.5.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Simple Dashboard",
    "it": "Simple Dashboard"
  },
  "description": {
    "en": "Vanilla widget dashboard for Homey Pro wall displays with an App Settings editor.",
    "it": "Dashboard a widget vanilla per wall display Homey Pro, con editor nelle Impostazioni app."
  },
  "category": ["tools"],
  "tags": {
    "en": ["http", "dashboard", "wall display", "widgets", "diagnostics"],
    "it": ["http", "dashboard", "wall display", "widget", "diagnostica"]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "ilpaolino"
  },
  "brandColor": "#1F4B5C",
  "api": {
    "listDisplays": {
      "method": "GET",
      "path": "/displays"
    },
    "getDashboard": {
      "method": "GET",
      "path": "/displays/:displayId/dashboard"
    },
    "saveDashboard": {
      "method": "PUT",
      "path": "/displays/:displayId/dashboard"
    }
  }
}

        "titleFormatted": {
          "en": "Show interactive notification [[notification_key]] — [[title]] [[message]] ([[severity]], [[icon]], highlight [[highlight]], dismissable [[dismissable]], auto-open [[auto_open]], auto-close [[auto_close_seconds]]s, action [[enable_action]] [[action_id]] [[action_label]] [[action_text]], media [[media]])",
